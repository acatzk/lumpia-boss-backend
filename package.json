{
  "name": "lumpia-boss-backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "deploy:prod": "wrangler deploy --minify --env production src/index.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:generate:dev": "bun --env-file=.env.development run drizzle-kit generate --config ./src/config/drizzle-dev.config.ts",
    "db:generate:prod": "bun --env-file=.env.production run drizzle-kit generate --config ./src/config/drizzle-prod.config.ts",
    "db:push": "drizzle-kit push",
    "db:push:dev": "bun --env-file=.env.development run drizzle-kit push --config ./src/config/drizzle-dev.config.ts",
    "db:push:prod": "bun --env-file=.env.production run drizzle-kit push --config ./src/config/drizzle-prod.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "bun --env-file=.env.development run drizzle-kit migrate --config ./src/config/drizzle-dev.config.ts",
    "db:migrate:prod": "bun --env-file=.env.production run drizzle-kit migrate --config ./src/config/drizzle-prod.config.ts",
    "db:seed": "tsx seed.ts",
    "db:seed:dev": "bun --env-file=.env.development run tsx seed.ts",
    "db:seed:prod": "bun --env-file=.env.production run tsx seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "bun --env-file=.env.development run drizzle-kit studio --config ./src/config/drizzle-dev.config.ts",
    "db:studio:prod": "bun --env-file=.env.production run drizzle-kit studio --config ./src/config/drizzle-prod.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check --write src",
    "test": "vitest"
  },
  "dependencies": {
    "@fiberplane/hono": "0.5.2",
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.7.1",
    "hono": "^4.7.0",
    "hono-openapi": "^0.4.6",
    "zod": "^3.23.8",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.8.31",
    "@cloudflare/workers-types": "^4.20250508.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-seed": "^0.3.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "vitest": "^3.1.4",
    "wrangler": "^4.4.0"
  }
}
